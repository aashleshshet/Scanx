# Local Docker only. Copy to .env; fill values locally. Never commit .env.
# Use independent, randomly generated passwords (URL-safe characters for Postgres).
POSTGRES_PASSWORD=
ONESCANX_OPERATOR_PASSWORD=
# Exact HTTPS roots you operate; empty means scans cannot start.
ONESCANX_TARGETS=[]
# Optional cloud bridge: same secret on backend and existing Vercel project.
ONESCANX_BRIDGE_KEY=
# Vercel only: HTTPS backend origin; never a URL supplied by a site visitor.
ONESCANX_BACKEND_URL=
# Optional AI: backend only; explicit consent is also required in the UI.
AI_API_URL=https://ai-gateway.vercel.sh/v1/chat/completions
AI_API_KEY=
AI_MODEL=
# Worker fixture secrets must use this prefix. Reference names in scenario YAML.
ONESCANX_SCAN_TOKEN_A=
ONESCANX_SCAN_TOKEN_B=
